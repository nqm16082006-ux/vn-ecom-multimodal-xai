{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "headerText": "VN E-Commerce Multimodal XAI (PhoBERT + ViT/CLIP + Cross-Attention + SHAP/Grad-CAM + FastAPI/React). Always read GEMINI.md and docs/PLAN.md first for project rules and current phase.",
    "instructionFilePath": "GEMINI.md",
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "copyToClipboard": false,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 50
    }
  },
  "include": [
    "GEMINI.md",
    ".agents/**/*",
    "docs/**/*",
    "configs/**/*",
    "scripts/**/*",
    "src/**/*",
    "backend/**/*",
    "frontend/src/**/*",
    "frontend/package.json",
    "requirements.txt",
    "README.md",
    "repomix.config.json",
    ".repomixignore"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "repomix-output.xml",
      "data/**",
      "checkpoints/**",
      "reports/figures/**",
      "frontend/node_modules/**",
      "frontend/dist/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.webp",
      "**/*.pt",
      "**/*.pth",
      "**/*.safetensors",
      "**/*.parquet",
      "**/*.csv"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
